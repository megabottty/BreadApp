{
  "name": "the-daily-dough",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest",
    "test:ci": "vitest --run",
    "lint": "eslint --ext .ts,.js src server --max-warnings 0",
    "server": "node server/index.js",
    "dev": "concurrently \"npm run server\" \"npm start\""
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/animations": "^21.2.8",
    "@angular/cdk": "^21.2.8",
    "@angular/common": "^21.2.8",
    "@angular/compiler": "^21.2.8",
    "@angular/core": "^21.2.8",
    "@angular/forms": "^21.2.8",
    "@angular/material": "^21.2.8",
    "@angular/platform-browser": "^21.2.8",
    "@angular/router": "^21.2.8",
    "@supabase/supabase-js": "^2.90.1",
    "chart.js": "^4.5.1",
    "compression": "^1.8.1",
    "dotenv": "^17.2.3",
    "ng2-charts": "^8.0.0",
    "nodemailer": "^7.0.12",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "stripe": "^20.2.0",
    "tslib": "^2.3.0",
    "twilio": "^5.11.2"
  },
  "devDependencies": {
    "@angular/build": "^21.2.8",
    "@angular/cli": "^21.2.8",
    "@angular/compiler-cli": "^21.2.8",
    "@types/qrcode": "^1.5.6",
    "jsdom": "^27.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8",
    "concurrently": "^8.2.0",
    "eslint": "^8.44.0",
    "@typescript-eslint/parser": "^6.7.0",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "eslint-plugin-vitest": "^0.3.0",
    "zone.js": "^0.16.1",
    "@angular/platform-browser-dynamic": "^21.2.8"
  }
}
